{
  "name": "savecli",
  "version": "0.1.0",
  "description": "A token-efficient coding agent CLI. Full agent capability, minimal footprint.",
  "type": "module",
  "bin": {
    "savecli": "bin/savecli.mjs"
  },
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=20.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src test bin",
    "clean": "rm -rf dist",
    "prepack": "npm run build"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "cli",
    "coding-agent",
    "ai",
    "llm",
    "token-saving",
    "agent"
  ],
  "author": "SaveCLI contributors",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/node": "^22.9.0",
    "eslint": "^9.14.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vitest": "^2.1.5"
  }
}
